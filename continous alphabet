package hii;

public class square {

	public static void main(String[] args) {
		 //Continuous alphabet pattern
      char letter = 'A';
       for (int i = 1; i <= 5; i++) {
          for (int j = 1; j <= i; j++) {
              System.out.print(letter + " ");
             letter++;
           }
           System.out.println();
       }
        }

		  


}



		
		
	

	

